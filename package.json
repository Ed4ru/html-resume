{
  "name": "html-resume",
  "version": "3.1.0",
  "private": true,
  "description": "Generates an A4 PDF resume from a JSON data file, rendered with HTML and CSS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "preview": "node scripts/preview.ts --open",
    "pdf": "node scripts/pdf.ts",
    "build": "vp build",
    "check": "vp check",
    "test": "vp test",
    "schema": "node scripts/generate-schema.ts"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@valibot/to-json-schema": "^1.8.0",
    "pdfjs-dist": "^6.3.289",
    "puppeteer": "^25.12.0",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite-plus": "^1.0.0"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
