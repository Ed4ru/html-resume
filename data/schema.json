{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "html-resume/data/schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Link to data/schema.json, for editors: completion and validation. Ignored by the rendering.",
      "examples": [
        "./schema.json"
      ]
    },
    "lang": {
      "enum": [
        "fr",
        "en"
      ],
      "type": "string",
      "description": "Language of the document (page lang attribute) and of the labels printed on the resume: section and sidebar titles, end of a current position. Data content is displayed as is."
    },
    "settings": {
      "type": "object",
      "properties": {
        "showPrompt": {
          "type": "boolean",
          "description": "Shows the \"~ $ whoami\" line above the name."
        },
        "qr": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "URL encoded in the QR code, which is generated at render time. The alt text is derived from it (\"QR code en.wikipedia.org/wiki/Dwight_Schrute\").",
              "examples": [
                "https://en.wikipedia.org/wiki/Dwight_Schrute"
              ]
            },
            "label": {
              "type": "string",
              "description": "Caption shown next to the QR code."
            }
          },
          "additionalProperties": false,
          "description": "QR code at the bottom of the sidebar, on every page. Absent, or without url: no QR code."
        }
      },
      "required": [
        "showPrompt"
      ],
      "additionalProperties": false,
      "description": "Display options."
    },
    "name": {
      "type": "string",
      "description": "Full name, main heading of the resume."
    },
    "title": {
      "type": "string",
      "description": "Target job title, below the name. First ATS filter: reuse the job posting's title."
    },
    "tag": {
      "type": "string",
      "description": "Short addition next to the title.",
      "examples": [
        "TypeScript · Full-stack"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Profile paragraph below the header. Rich text."
    },
    "contact": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Short label on the left.",
            "examples": [
              "email",
              "phone",
              "web"
            ]
          },
          "value": {
            "type": "string",
            "description": "Displayed value."
          },
          "href": {
            "type": "string",
            "description": "Link (https:, mailto:, tel:). Without a link, the value is plain text."
          },
          "accent": {
            "type": "boolean",
            "description": "Shows the link in the accent color."
          }
        },
        "required": [
          "label",
          "value"
        ],
        "additionalProperties": false
      },
      "description": "Sidebar contact details, in display order."
    },
    "expertise": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Sidebar expertise, one line each. Rich text."
    },
    "stack": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Group name.",
            "examples": [
              "sales",
              "farming"
            ]
          },
          "level": {
            "type": "string",
            "description": "Level shown to the right of the group.",
            "examples": [
              "expert",
              "advanced"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "primary": {
                      "type": "boolean",
                      "description": "Highlights the technology."
                    }
                  },
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Technologies in the group. A string, or an object with primary: true for a filled chip."
          }
        },
        "required": [
          "label",
          "items"
        ],
        "additionalProperties": false
      },
      "description": "Sidebar technologies, by group."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "examples": [
              "English"
            ]
          },
          "level": {
            "type": "string",
            "description": "Displayed level.",
            "examples": [
              "C1 · family heritage"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Gauge length, in %."
          }
        },
        "required": [
          "name",
          "level",
          "value"
        ],
        "additionalProperties": false
      },
      "description": "Spoken languages, with a gauge."
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "description": "Job title."
          },
          "company": {
            "type": "string",
            "description": "Company. Rich text.",
            "examples": [
              "Dunder Mifflin"
            ]
          },
          "location": {
            "type": "string",
            "examples": [
              "Scranton, PA",
              "Remote"
            ]
          },
          "start": {
            "type": "string",
            "description": "Start date, as displayed.",
            "examples": [
              "Apr 2001"
            ]
          },
          "end": {
            "type": "string",
            "description": "End date, as displayed. When absent (and current absent or false), only the start date is shown. Ignored if current is true.",
            "examples": [
              "May 2013"
            ]
          },
          "current": {
            "type": "boolean",
            "description": "Current position: filled node in the timeline, and the end date is replaced by \"présent\" (lang 'fr') or \"present\" (lang 'en'), even if end is set."
          },
          "context": {
            "type": "string",
            "description": "One sentence about the company or product. Rich text."
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Achievements, one bullet each. Rich text."
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Technologies used, shown as tags."
          }
        },
        "required": [
          "role",
          "company",
          "start"
        ],
        "additionalProperties": false
      },
      "description": "Experience section, most recent first. An entry is never split across two pages."
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "degree": {
            "type": "string",
            "description": "Degree title."
          },
          "school": {
            "type": "string",
            "description": "School and city."
          },
          "start": {
            "type": "string",
            "examples": [
              "1988"
            ]
          },
          "end": {
            "type": "string",
            "examples": [
              "1992"
            ]
          },
          "level": {
            "type": "string",
            "description": "Level, shown after the dates.",
            "examples": [
              "Bachelor"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "Rich text."
                    },
                    "note": {
                      "type": "string",
                      "examples": [
                        "certified"
                      ]
                    }
                  },
                  "required": [
                    "label"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "description": "Titles or specializations earned. A string (rich text), or a label with a subtle note."
          }
        },
        "required": [
          "degree",
          "school",
          "start"
        ],
        "additionalProperties": false
      },
      "description": "Education section, most recent first."
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "description": "Project link, displayed without https:// or www."
          },
          "year": {
            "type": "string",
            "examples": [
              "2005"
            ]
          },
          "description": {
            "type": "string",
            "description": "Rich text."
          },
          "stack": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Technologies used, shown as tags."
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "description": "Personal projects section."
    }
  },
  "required": [
    "lang",
    "settings",
    "name",
    "title",
    "contact"
  ],
  "additionalProperties": false,
  "title": "Resume data",
  "description": "JSON file passed to pnpm pdf and pnpm preview with --data (data/example.json by default). Fields marked \"rich text\" accept **bold** (highlighted keyword) and → (rendered as an arrow, read as an ASCII hyphen in the PDF text)."
}
